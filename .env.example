# PaiVoice realtime core — voice-only deployment
# Keep real credentials in a server-only environment file; never commit them.
PAIVOICE_HOST=127.0.0.1
PAIVOICE_PORT=8780
# PORT is used as a fallback by managed platforms.
PORT=8780

# Required for production. Use a random value of at least 32 bytes.
# This secret must also exist only in the trusted App backend that signs tickets.
PAIVOICE_AUTH_SECRET=
PAIVOICE_ALLOWED_ORIGINS=https://your-app.example

# First release is voice-only. Video/screen/vision events remain disabled.
PAIVOICE_ENABLE_VIDEO=false
PAIVOICE_ASR_PROVIDER=mock
PAIVOICE_TTS_PROVIDER=mock

# Real provider keys are added only to the server's secret store after transport tests.
# ASR (Groq example)
# PAIVOICE_ASR_PROVIDER=groq
# PAIVOICE_ASR_API_KEY=

# TTS: MiniMax matches Float's T2A V2 request settings.
# Set the same model and Voice ID as the character's Float voice configuration.
# PAIVOICE_TTS_PROVIDER=minimax
# PAIVOICE_TTS_API_KEY=
# PAIVOICE_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# PAIVOICE_MINIMAX_MODEL=speech-01-turbo
# PAIVOICE_MINIMAX_VOICE_ID=
# PAIVOICE_MINIMAX_SPEED=1.0
# PAIVOICE_MINIMAX_PITCH=0
# PAIVOICE_MINIMAX_EMOTION=
# PAIVOICE_MINIMAX_LANGUAGE_BOOST=
# Streaming uses 44.1kHz mono PCM chunks for immediate playback.
# Set false for Float-compatible 44.1kHz/256kbps MP3 output (buffered playback).
# PAIVOICE_MINIMAX_STREAM=true

# Alternative TTS provider
# PAIVOICE_TTS_PROVIDER=elevenlabs
# PAIVOICE_ELEVEN_VOICE_ID=

# Optional Char adapter; keep URL/token server-side.
# PAIVOICE_ADAPTER_URL=
# PAIVOICE_ADAPTER_TOKEN=

PAIVOICE_MAX_TURN_SECONDS=60
PAIVOICE_RESUME_SECONDS=60
