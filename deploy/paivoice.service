[Unit]
Description=PaiVoice realtime WebSocket service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paivoice
Group=paivoice
WorkingDirectory=/opt/paivoice/packages/realtime-core
EnvironmentFile=/etc/paivoice/paivoice.env
ExecStart=/opt/paivoice/venv/bin/python /opt/paivoice/packages/realtime-core/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
